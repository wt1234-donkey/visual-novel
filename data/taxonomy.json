  "interactionModes": {
    "文字输入": "键入动词、对象或自由会话推进游戏；命名、存档名与单个密码框不计。",
    "选项分支": "选择叙事回应、路线、事件或视角；不把普通系统菜单、知识问答选项算成剧情分支。",
    "菜单指令": "从预设的查看、交谈、移动、使用等行动命令或对象菜单推进；与键入词句区分。",
    "点击调查": "用光标、触摸或指针选择场景对象、热点和物品进行调查；点击翻页不计。",
    "阅读推进": "阅读文本或观看剧情并翻页推进；不表示一定无选项，可与分支等方式并列。",
    "直接移动": "直接控制角色或视角在二维／三维空间移动；选择地点菜单本身不计。",
    "即时动作": "直接控制跳跃、格斗、躲避或其他实时动作；战斗题材和不可操作的战斗演出不计。",
    "限时反应": "在指定时间内按键、连按、动作提示或触发机关；与无时限的剧情选项分开。",
    "瞄准射击": "通过瞄准、射击或武器控制参与游戏。",
    "驾驶操控": "转向、加速、刹车等直接驾驶操作；经营车队或赛车下注不计。",
    "日程养成": "安排练习、课程、工作或活动，管理人物能力与成长参数。",
    "资源经营": "管理金钱、资源、设施、生产或经营活动。",
    "战术策略": "部署、移动或指挥单位，进行战术或全局战略决策；不从战争背景推定。",
    "战斗指令": "选择技能、攻击、队伍等战斗命令；不限定是否严格回合制。",
    "卡牌棋盘": "按卡牌、麻将、双六、围棋、将棋等规则出牌或走棋。",
    "规则对战": "按猜拳等明确回合规则对战，区别于叙事选项与实时格斗。",
    "谜题操作": "通过机关、道具组合、拼图、排列或其他专门操作解谜；推理题材本身不计。",
    "知识问答": "回答知识、人物识别等有正确答案的问题；区别于剧情回应选项。",
    "节奏演奏": "按节拍、音符提示进行音乐输入；安排音乐练习不自动归此类。",
    "打字操作": "按指定文字进行打字练习或计分；区别于自由输入冒险指令。",
    "摄影取景": "可操作的取景、构图与拍摄；仅观看照片不计。",
    "设备互动": "与专用设备或外设联动的互动。",
    "待核实": "临时核对状态：既有资料不足以判断具体操作，不是一种正式互动方式。",
    "视角切换": "在同一叙事的角色、时间或内心视角之间切换阅读路径；不据此宣称改变事件或结局。"
  }
}
