  "policy": "连续核查M第11—15项；按原作开发机种登记，明确共同开发不改独作，移植／年代异文／复合个体身份分别处理。",
  "identityCorrections": [
    {
      "reviewId": "AZM3-I01",
      "entityId": "entity-name-fec7ac8f12b1",
      "rawName": "松下電器産業",
      "before": {
        "type": "unknown",
        "verification": "unresolved"
      },
      "type": "company",
      "status": "sourceReviewed",
      "sources": [
        "https://holdings.panasonic/jp/corporate/about/history/chronicle/2008.html"
      ],
      "note": "Panasonic官方历史明确1935起使用松下電器産業株式会社公司名，2008改名；独立订正1994旧发行节点为历史公司类别，保留两条既有发行及原文。Micro Cabin官网开发实绩在Puppet Tale和Powers Kingdom两项1994年3DO原作行明确共同开发（松下電器産業），分别追加两条联合制作。只限这两部原作；Myst的1995年3DO是后发版本，不能倒填1993原作。与上一批松下／Panasoft复合节点分设，不自动创建更名或品牌关系，不将1935公司设立当作新专题准入。"
    },
    {
      "reviewId": "AZM3-I02",
      "entityId": "entity-name-61d0027ef7ce",
      "rawName": "MediaWorks",
      "before": {
        "type": "unknown",
        "verification": "unresolved"
      },
      "type": "company",
      "status": "sourceReviewed",
      "sources": [
        "https://group.kadokawa.co.jp/documents/topics/20080228_2.pdf"
      ],
      "note": "KADOKAWA于2008年2月28日的当事方公告明确株式会社メディアワークス为合并存续公司，合并后计划更名ASCII MEDIA WORKS Inc.，足以独立确认旧MediaWorks公司类别。旧1997发行与原文保持；合并方案不等于给旧公司追加原作开发，也不由Taito现行重制目录把1997作品开发移交给后发发行方。旧ASCII、MediaWorks及后起同名出版品牌不自动合并；逐作制作继续待核。"
    }
  ],
