      "at": "2026-11-14T08:00:17.000Z",
      "reason": "NEXTON官方历史目录将MOON.列在Tactics品牌下，原版为1997-11-21，RENEWAL为1998、DVD和CD版为2002；本次只选原作登记年1997。"
    },
    "[\"work\",\"vndb-table-20261103-v15\",\"vndb-table-20261103-v15\",\"title\"]": {
      "assertionId": "r07-evidence-001-moon-tactics-title",
      "operationId": "r07-evidence-001-select-moon-tactics-title",
      "actor": "wt1234-donkey",
      "at": "2026-11-14T08:00:19.000Z",
      "reason": "采用NEXTON官方Tactics产品目录的原作标题MOON.，保留句点及大小写；该名称选用不引发与ASCII反RPG moon的身份归并。"
    },
    "[\"work\",\"erogamescape-table-20261103-38699\",\"erogamescape-table-20261103-38699\",\"firstYear\"]": {
